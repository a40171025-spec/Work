---
import manifest from '../data/hero-manifest.json';
const b = manifest.base;
---
<div class="loader" role="progressbar" aria-label="טוען את הפתיחה" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
  <div class="loader__grid" aria-hidden="true"></div>
  <div class="loader__cross" aria-hidden="true"></div>
  <picture class="loader__art" aria-hidden="true">
    <source media="(max-aspect-ratio: 4/5)" srcset={`${b}lineart-m.webp`} />
    <img src={`${b}lineart-d.webp`} alt="" decoding="async" fetchpriority="high" />
  </picture>
  <p class="loader__brand" aria-hidden="true">Paradise Watch</p>
  <p class="loader__corner loader__corner--tl" aria-hidden="true">Loading</p>
  <p class="loader__corner loader__corner--tr" aria-hidden="true">שעונים במראה יוקרתי, במחיר נגיש</p>
  <div class="loader__corner loader__corner--bl" aria-hidden="true">
    <div class="loader__pct"><span data-pct>000</span>%</div>
    <div class="loader__bar"><i></i></div>
  </div>
  <p class="loader__corner loader__corner--br" data-count aria-hidden="true"></p>
  <div class="loader__scan" aria-hidden="true"></div>
</div>
