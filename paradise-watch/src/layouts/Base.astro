---
import '@fontsource-variable/heebo';
import '@fontsource-variable/jost';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { products, card } from '../data/products';
import { INSTAGRAM_URL, SITE_NAME, SITE_URL } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  jsonld?: object[];
}
const { title, description, path, ogImage = `${SITE_URL}/assets/img/og/aurelia-turquoise.jpg`, ogType = 'website', noindex = false, jsonld = [] } = Astro.props;
const canonical = `${SITE_URL}${path}`;

const store = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: SITE_NAME,
  url: SITE_URL,
  telephone: '+972-53-532-5643',
  paymentAccepted: 'Cash',
  currenciesAccepted: 'ILS',
  areaServed: 'מרכז ודרום ישראל',
  sameAs: [INSTAGRAM_URL],
};

// Minimal catalogue for the cart drawer and checkout (client side)
const catalog = Object.fromEntries(
  products.map((p) => [p.slug, { n: p.name, pre: p.preorder, img: p.photos ? card(p.slug).src.replace('-800', '-400') : '' }]),
);
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#2a1f17" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(store)} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip" href="#main">דלגו לתוכן</a>
    <Header solid />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <WhatsAppFloat />
    <div id="live" class="sr-only" aria-live="polite" aria-atomic="true"></div>
    <script type="application/json" id="pw-catalog" set:html={JSON.stringify(catalog)} />
    <script>
      import '../scripts/common';
    </script>
  </body>
</html>
